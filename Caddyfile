# Proxy com HTTPS na frente da aplicação. É a única porta de entrada vinda da rede.
#
# - DOMINIO com um domínio de verdade (apontando para este servidor, com as portas
#   80 e 443 abertas): o Caddy obtém e renova o certificado no Let's Encrypt sozinho.
# - DOMINIO vazio: usa "localhost" com um certificado da CA interna do Caddy
#   (o navegador vai avisar que não confia; serve para desenvolvimento).
{
	# Sem root, o Caddy não instala a própria CA de desenvolvimento no container (nem precisa).
	skip_install_trust
	http_port {$HTTP_PORTA:80}
	https_port {$HTTPS_PORTA:443}
	servers {
		# Só HTTP/1.1, até sair um Caddy compilado com Go 1.26.9 ou mais novo: o Caddy
		# 2.11.7 tem a CVE-2026-78669 (negação de serviço por HTTP/2). Para uma API de
		# academia, a perda de desempenho é irrelevante. Ver ADR 0014.
		protocols h1
	}
}

# HTTP só redireciona para HTTPS, com a porta certa mesmo quando não é a 443.
http://{$DOMINIO:localhost}:{$HTTP_PORTA:80} {
	redir https://{host}:{$HTTPS_PORTA:443}{uri} permanent
}

https://{$DOMINIO:localhost}:{$HTTPS_PORTA:443} {
	# Segunda barreira contra corpos enormes (a aplicação também limita, em 64 KB).
	request_body {
		max_size 1MB
	}

	# A API (e o health): repassa X-Forwarded-For (IP real do cliente) e X-Forwarded-Proto
	# (https) à aplicação.
	handle /api/* {
		reverse_proxy app:8090
	}
	handle /actuator/* {
		reverse_proxy app:8090
	}

	# O resto são as telas (ADR 0033), arquivos estáticos construídos na imagem. Caminho que
	# não é arquivo (ex.: /alunos/123) devolve o index.html: quem escolhe a tela é o React.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Só scripts, estilos e imagens do próprio site, e conexões só com a própria API: um
		# script injetado não roda nem manda dados para fora. Sem estilo inline.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		header X-Content-Type-Options nosniff
		header Referrer-Policy no-referrer
		header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Os arquivos de /assets têm o hash do conteúdo no nome: podem ficar em cache para sempre.
		# O index.html não: ele aponta para os assets da versão atual.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pagina not path /assets/*
		header @pagina Cache-Control "no-cache"
	}

	# Não anuncia o servidor na resposta.
	header -Server
}
