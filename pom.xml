<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>br.com.academiagestao</groupId>
	<artifactId>academia-gestao</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!--
			Correções de segurança antes de chegarem ao Spring Boot (o 4.1.1 traz Tomcat
			11.0.24 e Jackson 3.1.5, com CVEs conhecidas). Remover quando o Boot trouxer
			versões iguais ou mais novas.
		-->
		<tomcat.version>11.0.27</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Testes de arquitetura: as fronteiras entre módulos viram regras verificadas. -->
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.5.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Teste de mutação (PIT) nas regras de domínio: altera o código de propósito e confere
			se algum teste falha. Mutação que sobrevive = regra sem teste de verdade.
			Uso: ./mvnw -P mutacao test-compile org.pitest:pitest-maven:mutationCoverage
			Relatório: target/pit-reports/index.html
		-->
		<profile>
			<id>mutacao</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.30.1</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<!-- Conferida pelo ListaDaMutacaoTest (pendências baixas, item 27): toda entidade, o
							     domínio da cobrança e a classe de cada teste de unidade (menos os services, que
							     os testes com banco é que cobrem). -->
							<targetClasses>
								<param>br.com.academiagestao.compartilhado.Cpf</param>
								<param>br.com.academiagestao.compartilhado.Identidade</param>
								<param>br.com.academiagestao.compartilhado.SmsConfig*</param>
								<param>br.com.academiagestao.compartilhado.MensageiroSms</param>
								<param>br.com.academiagestao.noticias.DadosDaPublicacao</param>
								<param>br.com.academiagestao.noticias.TipoDeArquivo*</param>
								<param>br.com.academiagestao.folha.Combinado</param>
								<param>br.com.academiagestao.folha.SemLogin</param>
								<param>br.com.academiagestao.noticias.AssinaturaDosAnexos*</param>
								<param>br.com.academiagestao.avisos.Marco</param>
								<param>br.com.academiagestao.avisos.TextosDosAvisos*</param>
								<param>br.com.academiagestao.alunos.Aluno</param>
								<param>br.com.academiagestao.alunos.FaixaEtaria</param>
								<param>br.com.academiagestao.compartilhado.Nascimento</param>
								<param>br.com.academiagestao.auditoria.AuditoriaNoBanco</param>
								<param>br.com.academiagestao.auth.GeradorDeSenhaTemporaria</param>
								<param>br.com.academiagestao.auth.LimiteDeRequisicoes</param>
								<param>br.com.academiagestao.auth.PoliticaDeSenha</param>
								<param>br.com.academiagestao.auth.SenhasAoMesmoTempoProperties</param>
								<param>br.com.academiagestao.auth.SenhasComTeto</param>
								<param>br.com.academiagestao.auth.SessaoProperties</param>
								<param>br.com.academiagestao.auth.Usuario</param>
								<param>br.com.academiagestao.cobranca.dominio.*</param>
								<param>br.com.academiagestao.compartilhado.Correio</param>
								<param>br.com.academiagestao.compartilhado.ExclusaoRecusadaException</param>
								<param>br.com.academiagestao.compartilhado.ProxyConfiavel</param>
								<param>br.com.academiagestao.compartilhado.RecursoModificadoException</param>
								<param>br.com.academiagestao.compartilhado.VersaoEsperada</param>
								<param>br.com.academiagestao.matriculas.FormaDePagamento</param>
								<param>br.com.academiagestao.matriculas.Matricula</param>
								<param>br.com.academiagestao.matriculas.Trancamento</param>
								<param>br.com.academiagestao.pagamentos.ConfiguracaoDoPagamentoOnline</param>
								<param>br.com.academiagestao.pagamentos.PagamentoOnline</param>
								<param>br.com.academiagestao.pagamentos.TravaDoSimulado</param>
								<param>br.com.academiagestao.planos.Plano</param>
								<param>br.com.academiagestao.treinos.DivisaoDaFicha</param>
								<param>br.com.academiagestao.treinos.Exercicio</param>
								<param>br.com.academiagestao.treinos.ExercicioDaFicha</param>
								<param>br.com.academiagestao.treinos.Ficha</param>
							</targetClasses>
							<!-- Todos os testes de unidade (sem Spring e sem banco): rápidos o bastante para cada
							     mutação. Também conferida pelo ListaDaMutacaoTest. -->
							<targetTests>
								<param>br.com.academiagestao.alunos.AlunoServiceTest</param>
								<param>br.com.academiagestao.alunos.AlunoTest</param>
								<param>br.com.academiagestao.alunos.FaixaEtariaTest</param>
								<param>br.com.academiagestao.compartilhado.NascimentoTest</param>
								<param>br.com.academiagestao.compartilhado.CpfTest</param>
								<param>br.com.academiagestao.compartilhado.IdentidadeTest</param>
								<param>br.com.academiagestao.compartilhado.SmsConfigTest</param>
								<param>br.com.academiagestao.noticias.DadosDaPublicacaoTest</param>
								<param>br.com.academiagestao.noticias.TipoDeArquivoTest</param>
								<param>br.com.academiagestao.folha.CombinadoTest</param>
								<param>br.com.academiagestao.folha.SemLoginTest</param>
								<param>br.com.academiagestao.avisos.MarcoTest</param>
								<param>br.com.academiagestao.avisos.TextosDosAvisosTest</param>
								<param>br.com.academiagestao.auditoria.AuditoriaNoBancoTest</param>
								<param>br.com.academiagestao.auth.AutenticacaoServiceTest</param>
								<param>br.com.academiagestao.auth.GeradorDeSenhaTemporariaTest</param>
								<param>br.com.academiagestao.auth.LimiteDeRequisicoesTest</param>
								<param>br.com.academiagestao.auth.PoliticaDeSenhaTest</param>
								<param>br.com.academiagestao.auth.PrimeiroAdminInicializadorValidacaoTest</param>
								<param>br.com.academiagestao.auth.SenhasComTetoTest</param>
								<param>br.com.academiagestao.auth.SessaoPropertiesTest</param>
								<param>br.com.academiagestao.auth.SoConsultaSeSomenteLeituraTest</param>
								<param>br.com.academiagestao.auth.TempoDoPedidoDeCodigoTest</param>
								<param>br.com.academiagestao.auth.UsuarioTest</param>
								<param>br.com.academiagestao.cobranca.dominio.*Test</param>
								<param>br.com.academiagestao.compartilhado.CorreioTest</param>
								<param>br.com.academiagestao.compartilhado.ExclusaoRecusadaExceptionTest</param>
								<param>br.com.academiagestao.compartilhado.ProxyConfiavelTest</param>
								<param>br.com.academiagestao.compartilhado.UsuarioDaAplicacaoNoBancoValidacaoTest</param>
								<param>br.com.academiagestao.compartilhado.VersaoEsperadaTest</param>
								<param>br.com.academiagestao.matriculas.CobrancasDasMatriculasAntigasAoSubirTest</param>
								<param>br.com.academiagestao.matriculas.FormaDePagamentoTest</param>
								<param>br.com.academiagestao.matriculas.MatriculaTest</param>
								<param>br.com.academiagestao.pagamentos.ConfiguracaoDoPagamentoOnlineTest</param>
								<param>br.com.academiagestao.pagamentos.PagamentoOnlineTest</param>
								<param>br.com.academiagestao.pagamentos.TravaDoSimuladoTest</param>
								<param>br.com.academiagestao.planos.PlanoTest</param>
								<param>br.com.academiagestao.treinos.ExercicioTest</param>
								<param>br.com.academiagestao.treinos.FichaTest</param>
							</targetTests>
							<mutators>
								<mutator>STRONGER</mutator>
							</mutators>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<timestampedReports>false</timestampedReports>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
