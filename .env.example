# Copie para .env (que não vai para o Git) e preencha com valores reais:
#   cp .env.example .env
# O Docker Compose lê o .env automaticamente.

# Senha do dono do banco (usado só pelas migrations). Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=
# Senha do usuário da aplicação no banco (só lê e grava dados). Mínimo de 16 caracteres.
# Gere com: openssl rand -base64 24
DB_APP_SENHA=

# Primeiro ADMIN, criado na inicialização só se o banco ainda não tiver nenhum ADMIN.
# A senha abaixo vale só para o primeiro acesso: o sistema exige trocá-la em seguida.
# Depois que ele existir, estas variáveis são ignoradas (trocar aqui não muda a senha).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@academia.local
# Mínimo de 12 caracteres. Gere uma com: openssl rand -base64 24
ADMIN_SENHA=

# Chave que assina os tokens de login (HMAC-SHA256). Base64, no mínimo 32 bytes.
# Gere uma com: openssl rand -base64 32
# Trocar a chave invalida todos os tokens já emitidos (todo mundo precisa logar de novo).
JWT_SEGREDO=
# Validade do token de acesso (ex.: 15m, 1h).
JWT_EXPIRACAO=15m

# HTTPS (Caddy). Com um domínio apontando para o servidor e as portas 80/443 abertas,
# o certificado do Let's Encrypt é emitido e renovado sozinho. Vazio = localhost
# com certificado de desenvolvimento.
DOMINIO=
# Portas públicas do Caddy. Em produção, 80 e 443 (o Let's Encrypt exige).
HTTP_PORTA=80
HTTPS_PORTA=443

# Limites de recursos dos containers (o servidor é dividido com outros serviços).
# Memória: 512m, 1g, 2g...; CPUs: núcleos (pode ser fracionário, como 1.5).
APP_MEMORIA=1g
APP_CPUS=2
POSTGRES_MEMORIA=1g
POSTGRES_CPUS=2

# Backup diário do banco (ADR 0020). Pasta no servidor (fora do Git) e hora (0-23) do backup.
# O container grava como este usuário (veja com: id -u; id -g). Copie a pasta para fora do
# servidor: contra disco queimado, só uma cópia em outro lugar salva.
BACKUP_PASTA=./backups
BACKUP_HORA=3
BACKUP_UID=1000
BACKUP_GID=1000

# Pagamento online pelo app, com Pix e boleto (ADR 0034). "desligado" (padrão): o app não
# oferece pagar. "simulado": empresa de mentira, para desenvolver e testar (NUNCA em produção:
# a mensalidade fica paga sem dinheiro nenhum). Para uma empresa de verdade, é preciso
# implementar a classe dela (ProvedorDePagamento) e pôr aqui o nome e as chaves da conta.
PAGAMENTOS_PROVEDOR=desligado
# Só no simulado: o token que o aviso de teste precisa trazer. Gere com: openssl rand -base64 24
PAGAMENTOS_TOKEN_DO_AVISO_SIMULADO=
