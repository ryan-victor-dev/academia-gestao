# Copie para .env (que não vai para o Git) e preencha com valores reais:
#   cp .env.example .env
# O Docker Compose lê o .env automaticamente.

# Senha do dono do banco (usado só pelas migrations). Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=
# Senha do usuário da aplicação no banco (só lê e grava dados). Mínimo de 16 caracteres.
# Gere com: openssl rand -base64 24
DB_APP_SENHA=

# Primeiro ADMIN, criado na inicialização só se o banco ainda não tiver nenhum ADMIN.
# A senha abaixo vale só para o primeiro acesso: o sistema exige trocá-la em seguida.
# Depois que ele existir, estas variáveis são ignoradas (trocar aqui não muda a senha).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@academia.local
# Mínimo de 12 caracteres. Gere uma com: openssl rand -base64 24
ADMIN_SENHA=

# Chave que assina os tokens de login (HMAC-SHA256). Base64, no mínimo 32 bytes.
# Gere uma com: openssl rand -base64 32
# Trocar a chave invalida todos os tokens já emitidos (todo mundo precisa logar de novo).
JWT_SEGREDO=
# Validade do token de acesso (ex.: 15m, 1h).
JWT_EXPIRACAO=15m

# HTTPS (Caddy). Com um domínio apontando para o servidor e as portas 80/443 abertas,
# o certificado do Let's Encrypt é emitido e renovado sozinho. Vazio = localhost
# com certificado de desenvolvimento.
DOMINIO=
# Portas públicas do Caddy. Em produção, 80 e 443 (o Let's Encrypt exige).
HTTP_PORTA=80
HTTPS_PORTA=443
# Rede entre o Caddy e a aplicação, com o IP fixo do Caddy (o único em que a aplicação confia
# para saber o IP do cliente). Troque só se colidir com outra rede do servidor; o IP precisa
# estar dentro da rede.
PROXY_REDE=10.250.250.0/24
PROXY_IP_DO_CADDY=10.250.250.10

# Limites de recursos dos containers (o servidor é dividido com outros serviços).
# Memória: 512m, 1g, 2g...; CPUs: núcleos (pode ser fracionário, como 1.5).
APP_MEMORIA=1g
APP_CPUS=2
# Senhas conferidas ao mesmo tempo (o BCrypt ocupa um núcleo por senha): acima disso, o login
# espera até meio segundo por uma vaga e, sem vaga, recebe 503. 0 = um por núcleo (os APP_CPUS).
SENHAS_TETO=0
# Espaço total dos anexos das notícias (fotos, vídeos e PDFs, ADR 0047), guardados no banco e no backup:
# 5GB, 10GB... Acima dele, novos anexos são recusados até alguém excluir os antigos.
ANEXOS_ESPACO_TOTAL=5GB
# SMS dos avisos (ADR 0047): desligado (o padrão: os avisos vão só por e-mail) ou simulado (só desenvolvimento: guarda
# na tabela sms_simulados e não manda; recusado com DOMINIO). A empresa de verdade ainda será escolhida.
SMS_PROVEDOR=desligado
POSTGRES_MEMORIA=1g
POSTGRES_CPUS=2

# Backup diário do banco (ADR 0020). Pasta no servidor (fora do Git) e hora (0-23) do backup.
# O container grava como este usuário (veja com: id -u; id -g). Copie a pasta para fora do
# servidor: contra disco queimado, só uma cópia em outro lugar salva.
BACKUP_PASTA=./backups
BACKUP_HORA=3
BACKUP_UID=1000
BACKUP_GID=1000
# Chave pública do age (começa com age1): o backup sai cifrado com ela (ADR 0041). Sem ela, o
# sistema não sobe. Gere o par FORA do servidor (veja o README, Backup) e guarde a chave privada
# (AGE-SECRET-KEY-...) num lugar seguro e longe dele: sem ela, nenhum backup volta.
BACKUP_CHAVE_PUBLICA=

# Pagamento online pelo app, com Pix e boleto (ADR 0034). "desligado" (padrão): o app não
# oferece pagar. "simulado": empresa de mentira, para desenvolver e testar (NUNCA em produção:
# a mensalidade fica paga sem dinheiro nenhum; com um DOMINIO de verdade, a aplicação nem
# sobe com ele). Para uma empresa de verdade, é preciso
# implementar a classe dela (ProvedorDePagamento) e pôr aqui o nome e as chaves da conta.
PAGAMENTOS_PROVEDOR=desligado
# Só no simulado: o token que o aviso de teste precisa trazer. Gere com: openssl rand -base64 24
PAGAMENTOS_TOKEN_DO_AVISO_SIMULADO=

# E-mail (ADR 0038): os códigos de confirmação do e-mail e de recuperação da senha. Sem EMAIL_HOST,
# o e-mail fica desligado: ninguém precisa confirmar o e-mail, e o "esqueci a senha" não aparece.
# Qualquer servidor SMTP serve (o do seu provedor de e-mail, Brevo, Amazon SES...).
EMAIL_HOST=
EMAIL_PORTA=587
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_TLS=true
# O "de" dos e-mails, por exemplo: Academia <nao-responda@suaacademia.com.br>
EMAIL_REMETENTE=
# Para testar sem mandar nada para fora: EMAIL_HOST=mailpit, EMAIL_PORTA=1025, EMAIL_TLS=false e
# docker compose --profile email-de-teste up -d; os e-mails aparecem em http://localhost:8025.
