# Copie para .env (que não vai para o Git) e preencha com valores reais:
#   cp .env.example .env
# O Docker Compose lê o .env automaticamente.

# Primeiro ADMIN, criado na inicialização só se o banco ainda não tiver nenhum ADMIN.
# Depois que ele existir, estas variáveis são ignoradas (trocar aqui não muda a senha).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@academia.local
# Mínimo de 12 caracteres. Gere uma com: openssl rand -base64 24
ADMIN_SENHA=
